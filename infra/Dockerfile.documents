FROM node:24.22.1-bookworm-slim
RUN apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 upgrade -y && apt-get -o Acquire::Retries=3 install -y --no-install-recommends poppler-utils fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/cubers-documents
COPY infra/document-review.mjs ./document-review.mjs
USER node
ENV DOCUMENT_REVIEW_SOCKET=/run/cubers-documents/review.sock
CMD ["node", "document-review.mjs"]
