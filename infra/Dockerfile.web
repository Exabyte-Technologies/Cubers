ARG NODE_IMAGE=node:24.22.1-bookworm-slim
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine
FROM ${NODE_IMAGE} AS build
WORKDIR /app
ENV NPM_CONFIG_AUDIT=false EXPO_NO_TELEMETRY=1 CI=1
COPY package.json package-lock.json tsconfig.base.json ./
COPY .dockerignore .dockerignore
COPY apps/api/package.json apps/api/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY packages/core/package.json packages/core/package.json
COPY scripts/prepare-dependencies.cjs scripts/prepare-dependencies.cjs
COPY scripts/web-build-proof.mjs scripts/web-build-proof.mjs
COPY infra/Dockerfile.web infra/nginx.web.conf infra/
RUN npm ci --no-audit --workspace @cubers/mobile --workspace @cubers/core --include-workspace-root
COPY apps/mobile apps/mobile
COPY packages/core packages/core
ARG EXPO_PUBLIC_REGION=INTL
ARG EXPO_PUBLIC_API_URL_INTL
ARG EXPO_PUBLIC_API_URL_CN
ARG EXPO_PUBLIC_COMMUNITY_DISCOVERY_URL
ENV EXPO_PUBLIC_REGION=${EXPO_PUBLIC_REGION} \
    EXPO_PUBLIC_API_URL_INTL=${EXPO_PUBLIC_API_URL_INTL} \
    EXPO_PUBLIC_API_URL_CN=${EXPO_PUBLIC_API_URL_CN} \
    EXPO_PUBLIC_COMMUNITY_DISCOVERY_URL=${EXPO_PUBLIC_COMMUNITY_DISCOVERY_URL}
RUN npm run build:core && npm run export:web -w @cubers/mobile
RUN node scripts/web-build-proof.mjs /app/web-build-proof.json

FROM ${NGINX_IMAGE} AS runtime
USER root
RUN apk --no-cache upgrade && rm -rf /usr/share/nginx/html && mkdir -p /usr/share/nginx/html
COPY infra/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/mobile/dist /usr/share/nginx/html
COPY --from=build --chown=101:101 /app/web-build-proof.json /opt/cubers-web-build.json
USER 101
EXPOSE 8080
