# Rebuild the same upstream Caddy release with the patched supported Go runtime.
# The published Caddy 2.11.7 binary was built before Go's October security fixes.
FROM golang:1.26.10-alpine AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /build
# x/net's HTTP/2 implementation also needs its independent security release.
RUN go mod init caddy && \
    go get github.com/caddyserver/caddy/v2/cmd/caddy@v2.11.7 golang.org/x/net@v0.60.0
RUN go build -trimpath -buildvcs=false \
    -ldflags="-X github.com/caddyserver/caddy/v2.CustomVersion=v2.11.7+cubers.go1.26.10" \
    -o /go/bin/caddy github.com/caddyserver/caddy/v2/cmd/caddy

FROM caddy:2.11.7-alpine
RUN apk --no-cache upgrade
COPY --from=build /go/bin/caddy /usr/bin/caddy
RUN caddy version
