# Copy to .env.local for development. Never commit credentials.
NODE_ENV=development
# Server-only installation region; development/test use this without IP lookup.
REGION=INTL
PORT=3000
HOST=127.0.0.1
TRUSTED_PROXY_CIDRS=
MEDIA_DAILY_BYTES=1073741824
DATABASE_URL=postgresql://cubers:cubers_dev_only@127.0.0.1:54329/cubers
REDIS_URL=redis://127.0.0.1:6389
SCRAMBLE_TIMEOUT_MS=30000
APP_ORIGIN=http://localhost:8081
ADMIN_ORIGIN=http://localhost:4173
SMTP_URL=smtp://127.0.0.1:10259
MAIL_FROM=Cubers <noreply@cubers.local>
S3_ENDPOINT=http://127.0.0.1:9009
S3_REGION=us-east-1
S3_BUCKET=cubers-intl
S3_ACCESS_KEY=cubers_dev
S3_SECRET_KEY=cubers_dev_only_change_before_release
# For host consent-page review, start scripts/local-document-review.mjs and set
# CONSENT_REVIEW_SOCKET to the private host socket it prints.
# disabled uses authored explanations; mock calls scripts/mock-ai.ts, never a real provider.
AI_MODE=mock
AI_BASE_URL=http://127.0.0.1:4010/v1
AI_MODEL=cubers-simulator
AI_MODERATION_MODEL=omni-moderation-latest
# Mainland live calls also require activated/authorized Alibaba guardrails.
AI_CN_GUARDRAILS_APPROVED=false
AI_API_KEY=
# Later: AI_MODE=live, AI_BASE_URL=https://your-approved-provider.example/v1,
# AI_MODEL=<your actual model>, AI_ALLOWED_HOSTS=your-approved-provider.example
# Keys stay on the server. Do not put them in EXPO_PUBLIC variables.
OPENAI_API_KEY=
QWEN_API_KEY=
AI_ALLOWED_HOSTS=api.openai.com
AI_CN_APPROVED_HOSTS=dashscope.aliyuncs.com
AI_TIMEOUT_MS=8000
CN_SOCIAL_APPROVED=false
CN_GAMES_APPROVED=false
CN_AI_APPROVED=false
PUBLIC_RELEASE_APPROVED=false
WORKER_ENABLED=true
# Local recovery work is opt-in. Never share journal directories or keys across
# regions; initialize/bind them before enabling file mode. See docs/RECOVERY.md.
DELETION_JOURNAL_MODE=disabled
# DELETION_JOURNAL_DIRECTORY=/absolute/private/regional-journal
# DELETION_JOURNAL_KEY_FILE=/absolute/private/deletion-journal.json

# Set only after regional advertising and archive-custody review. Cards remain off in settings.
SPONSORS_APPROVED=false

# App verification enrollment and action checks. Ranking remains independently gated.
APP_ATTESTATION_APPLE_ENABLED=false
APP_ATTESTATION_APPLE_RECEIPT_ENABLED=false
# Requires the approved receipt service and a separate account opt-in per key.
APP_ATTESTATION_APPLE_AUTO_REFRESH=false
# Separately commission the DeviceCheck service and a reviewed numeric risk policy.
# APP_ATTESTATION_APPLE_CREDENTIAL_FILE=/run/secrets/cubers-apple-devicecheck.json
# APP_ATTESTATION_APPLE_RISK_MAX=<operator-reviewed integer>
APP_ATTESTATION_APPLE_APP_ID=
APP_ATTESTATION_APPLE_BUILDS=
APP_ATTESTATION_APPLE_DISTRIBUTION=app-store
APP_ATTESTATION_OPENSSL_PATH=/usr/bin/openssl
APP_ATTESTATION_CN_APPROVED=false
# Set only on an approved deployment, to an owned private JSON key file.
# APP_ATTESTATION_RECEIPT_KEY_FILE=/run/secrets/cubers-app-receipts.json

# Optional international Google Play Standard verification. No credentials are bundled.
APP_ATTESTATION_GOOGLE_ENABLED=false
APP_ATTESTATION_GOOGLE_PROJECT_NUMBER=
APP_ATTESTATION_GOOGLE_PACKAGE=
APP_ATTESTATION_GOOGLE_SIGNERS=
APP_ATTESTATION_GOOGLE_BUILDS=
# APP_ATTESTATION_GOOGLE_CREDENTIAL_FILE=/run/secrets/cubers-play-service-account.json

# Optional monitor-only signed HTTPS alerts (off until fully configured).
# See docs/OPERATIONAL-DELIVERY.md and infra/compose.alerts.yml.
# OPERATIONS_ALERT_FILE=/run/secrets/cubers-operational-alerts.json
# OPERATIONS_ALERT_OUTBOX_DIRECTORY=/var/lib/cubers/alert-outbox
# OPERATIONS_ALERT_ALLOWED_HOSTS=alerts.example.invalid
# Overlay host settings: CUBERS_ALERT_ALLOWED_HOSTS,
# CUBERS_ALERT_KEY_HOST_DIRECTORY, CUBERS_ALERT_OUTBOX_HOST_DIRECTORY.
