{
  "cli": { "version": ">=16.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "NPM_CONFIG_AUDIT": "false" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "NPM_CONFIG_AUDIT": "false" }
    },
    "development-standalone": {
      "distribution": "internal",
      "android": { "gradleCommand": ":app:assembleDevelopment" },
      "ios": { "buildConfiguration": "Release" },
      "env": { "EXPO_PUBLIC_DEV_TOOLS": "true", "NPM_CONFIG_AUDIT": "false" }
    },
    "development-debug": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_DEV_TOOLS": "true", "NPM_CONFIG_AUDIT": "false" }
    },
    "production-intl": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_REGION": "INTL",
        "EXPO_PUBLIC_DEV_TOOLS": "false",
        "NPM_CONFIG_AUDIT": "false"
      }
    },
    "production-cn": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_REGION": "CN",
        "EXPO_PUBLIC_DEV_TOOLS": "false",
        "NPM_CONFIG_AUDIT": "false"
      }
    }
  },
  "submit": { "production-intl": {}, "production-cn": {} }
}
