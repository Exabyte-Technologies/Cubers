# Template only. Create a separate .env.production on each regional host.
# All example.invalid values require replacement; never commit real secrets.
NODE_ENV=production
REGION=INTL
PORT=3000
HOST=0.0.0.0
# Resolve the reviewed release images to immutable digests on each regional host.
CUBERS_POSTGRES_IMAGE=postgres:17-alpine
CUBERS_REDIS_IMAGE=redis:7-alpine
CUBERS_PROXY_IMAGE=cubers-proxy:local
CUBERS_WEB_IMAGE=cubers-web:local
# Match the HTTPS container's fixed address in compose.production.yml.
TRUSTED_PROXY_CIDRS=172.30.70.2/32
# Offline country data is bundled in the image; see docs/REGIONS.md for refresh.
# Optional custom read-only mount containing country.mmdb and manifest.json:
# GEOIP_DATABASE_DIRECTORY=/app/custom-geo
MEDIA_DAILY_BYTES=1073741824
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_SECRET
DATABASE_URL=postgresql://cubers:REPLACE_WITH_URL_ENCODED_SECRET@postgres:5432/cubers
REDIS_URL=redis://redis:6379
SCRAMBLE_TIMEOUT_MS=30000
API_DOMAIN=api.example.invalid
ADMIN_DOMAIN=admin.example.invalid
TLS_EMAIL=operator@example.invalid
# Public support/legal/deletion hostname, served by the included HTTPS proxy.
# Keep this distinct from API_DOMAIN and ADMIN_DOMAIN; replace before deployment.
APP_ORIGIN=https://app.example.invalid
# Public build configuration only. Replace these reserved example addresses
# with the real independent API/discovery origins before building for deployment.
EXPO_PUBLIC_API_URL_INTL=https://api-intl.example.invalid
EXPO_PUBLIC_API_URL_CN=https://api-cn.example.invalid
EXPO_PUBLIC_COMMUNITY_DISCOVERY_URL=https://community.example.invalid
ADMIN_ORIGIN=https://admin.example.invalid
SMTP_URL=smtps://REPLACE_WITH_PROVIDER_CREDENTIALS
MAIL_FROM=Cubers <support@exabyte.org.cn>
S3_ENDPOINT=https://storage.example.invalid
S3_REGION=REPLACE_WITH_REGIONAL_STORAGE_LOCATION
S3_BUCKET=REPLACE_WITH_PRIVATE_REGIONAL_BUCKET
S3_ACCESS_KEY=REPLACE_WITH_SCOPED_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_SECRET
S3_SSE=AES256
# Private Unix socket shared only with this community's isolated renderer.
CONSENT_REVIEW_SOCKET=/run/cubers-documents/review.sock
AI_MODE=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_MODERATION_MODEL=omni-moderation-latest
# Operator confirmation only after activating/authorizing Alibaba guardrails.
AI_CN_GUARDRAILS_APPROVED=false
AI_ALLOWED_HOSTS=api.openai.com
AI_CN_APPROVED_HOSTS=dashscope.aliyuncs.com
OPENAI_API_KEY=
QWEN_API_KEY=
AI_API_KEY=
AI_TIMEOUT_MS=8000
CN_SOCIAL_APPROVED=false
CN_GAMES_APPROVED=false
CN_AI_APPROVED=false
PUBLIC_RELEASE_APPROVED=false
WORKER_ENABLED=true

# Independent deletion journal; merge infra/compose.recovery.yml for production.
# Prepare owned mode-0700 directories and initialize once with recovery-operator.
DELETION_JOURNAL_MODE=file
DELETION_JOURNAL_DIRECTORY=/var/lib/cubers/deletion-journal
DELETION_JOURNAL_KEY_FILE=/run/secrets/cubers-deletion-journal.json
CUBERS_DELETION_JOURNAL_HOST_DIRECTORY=/srv/cubers-intl/deletion-journal
CUBERS_RECOVERY_KEY_HOST_DIRECTORY=/srv/cubers-intl/recovery-key
CUBERS_OPERATOR_REQUEST_HOST_DIRECTORY=/srv/cubers-intl/operator-request

# Optional offline database-only snapshot overlay; full recovery stays sealed.
CUBERS_SNAPSHOT_HOST_DIRECTORY=/srv/cubers-intl/encrypted-snapshots
# Optional maintenance-profile snapshot-expiry uses protected snapshot-expiry.json.
# It has no network and read-only key/journal/request mounts; see docs/SNAPSHOT-EXPIRY.md.
CUBERS_RECOVERY_IMAGE=cubers-recovery:local

# Offline consistent database/media vault; keys must be on separate private storage.
CUBERS_MEDIA_VAULT_HOST_DIRECTORY=/srv/cubers-intl/encrypted-media-vault
CUBERS_MEDIA_VAULT_KEY_HOST_DIRECTORY=/srv/cubers-intl/media-vault-keys

# App verification enrollment and action checks. Ranking remains independently gated.
APP_ATTESTATION_APPLE_ENABLED=false
APP_ATTESTATION_APPLE_RECEIPT_ENABLED=false
# Requires the approved receipt service and a separate account opt-in per key.
APP_ATTESTATION_APPLE_AUTO_REFRESH=false
# Separately commission the DeviceCheck service and a reviewed numeric risk policy.
# APP_ATTESTATION_APPLE_CREDENTIAL_FILE=/run/secrets/cubers-apple-devicecheck.json
# APP_ATTESTATION_APPLE_RISK_MAX=<operator-reviewed integer>
APP_ATTESTATION_APPLE_APP_ID=
APP_ATTESTATION_APPLE_BUILDS=
APP_ATTESTATION_APPLE_DISTRIBUTION=app-store
APP_ATTESTATION_OPENSSL_PATH=/usr/bin/openssl
APP_ATTESTATION_CN_APPROVED=false
# Set only on an approved deployment, to an owned private JSON key file.
# APP_ATTESTATION_RECEIPT_KEY_FILE=/run/secrets/cubers-app-receipts.json

# Optional international Google Play Standard verification. No credentials are bundled.
APP_ATTESTATION_GOOGLE_ENABLED=false
APP_ATTESTATION_GOOGLE_PROJECT_NUMBER=
APP_ATTESTATION_GOOGLE_PACKAGE=
APP_ATTESTATION_GOOGLE_SIGNERS=
APP_ATTESTATION_GOOGLE_BUILDS=
# APP_ATTESTATION_GOOGLE_CREDENTIAL_FILE=/run/secrets/cubers-play-service-account.json

# Optional monitor-only signed HTTPS alerts (off until fully configured).
# See docs/OPERATIONAL-DELIVERY.md and infra/compose.alerts.yml.
# OPERATIONS_ALERT_FILE=/run/secrets/cubers-operational-alerts.json
# OPERATIONS_ALERT_OUTBOX_DIRECTORY=/var/lib/cubers/alert-outbox
# OPERATIONS_ALERT_ALLOWED_HOSTS=alerts.example.invalid
# Overlay host settings: CUBERS_ALERT_ALLOWED_HOSTS,
# CUBERS_ALERT_KEY_HOST_DIRECTORY, CUBERS_ALERT_OUTBOX_HOST_DIRECTORY.
